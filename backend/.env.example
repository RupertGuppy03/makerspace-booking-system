# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit real credentials.

# Supabase Postgres connection string (Settings → Database → Connection string → .NET)
ConnectionStrings__DefaultConnection=Host=db.<project-ref>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<password>;SSL Mode=Require;Trust Server Certificate=true

# Supabase project URL — used to build the JWT issuer/authority
Supabase__Url=https://<project-ref>.supabase.co

# JWT signing secret (Settings → API → JWT Secret). Server-side only.
Supabase__JwtSecret=

# Where the frontend runs, for the CORS policy
Cors__AllowedOrigin=http://localhost:5173
