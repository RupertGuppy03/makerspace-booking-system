# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit real keys.
# Only variables prefixed with VITE_ are visible to the app.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" public key. Safe for the browser — do NOT put the service_role key here.
VITE_SUPABASE_ANON_KEY=

# Base URL of our ASP.NET Core API
VITE_API_BASE_URL=http://localhost:5000
